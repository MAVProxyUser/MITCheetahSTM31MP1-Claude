        <gravity>true</gravity>
        <gravity>true</gravity>
        <!-- Chase camera for headless video capture (record_video.py subscribes
             to /chase_cam). Mounted on the trunk: 1.9 m behind, 0.9 m up,
             pitched 22 deg down. Rides with the body, so a tumble is visible. -->
        <sensor name="chase_cam" type="camera">
          <always_on>1</always_on>
          <update_rate>20</update_rate>
          <topic>chase_cam</topic>
          <pose>-1.9 0 0.9 0 0.38 0</pose>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>300</far></clip>
          </camera>
        </sensor>
        <sensor name="cheetah_imu" type="imu">
          <always_on>1</always_on>
          <update_rate>500</update_rate>
          <topic>imu</topic>
          <imu />
        </sensor>
        <sensor name="cheetah_baro" type="air_pressure">
          <always_on>1</always_on>
          <update_rate>50</update_rate>
          <topic>air_pressure</topic>
          <air_pressure>
            <reference_altitude>0</reference_altitude>
          </air_pressure>
        </sensor>
        <sensor name="cheetah_gps" type="navsat">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>navsat</topic>
        </sensor>
      </link>
