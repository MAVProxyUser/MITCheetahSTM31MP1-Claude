    <!-- OpenPilot farm scenery (Clearpath cpr_agriculture + grass horizon ring),
         reused verbatim so the dog walks the same field the OP quadcopter flew. -->
    <include><uri>model://grass_horizon</uri></include>
    <include><uri>model://agriculture_visual</uri></include>

    <!-- World-fixed MISSION CAMERA: straight down over the mission area, wide
         enough for a 5 m star plus margin. Unlike the trunk-mounted chase_cam
         this never rolls with the robot, so the recording is stable and the
         planned-vs-actual ground track reads clearly. -->
    <model name="mission_cam">
      <static>true</static>
      <pose>0 0 22 0 1.5707963 1.5707963</pose>
      <link name="link">
        <sensor name="overhead_cam" type="camera">
          <always_on>1</always_on>
          <update_rate>20</update_rate>
          <topic>overhead_cam</topic>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image><width>1080</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>200</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>